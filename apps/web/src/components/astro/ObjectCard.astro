---
import type { CollectionEntry } from "astro:content";
interface Props {
  object: CollectionEntry<"objects">;
}
const { object } = Astro.props;
---
<a
  href={`/objects/${object.slug}`}
  class="block rounded-lg border border-neutral-200 bg-white p-4 transition-shadow hover:shadow-sm"
>
  <h2 class="font-medium">{object.data.name}</h2>
  <p class="mt-1 text-sm text-neutral-500">{object.data.summary}</p>
</a>
